################################################################
# Manage lets_deal deployment through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_lets_deal" "svm::deploy_program" {
    description = "Deploy lets_deal program"
    program = svm::get_program_from_anchor_project("lets_deal") 
    authority = signer.authority
    payer = signer.payer
}
